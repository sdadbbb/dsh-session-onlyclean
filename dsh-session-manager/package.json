{
  "name": "dsh-session-onlyclean",
  "version": "1.0.0",
  "type": "module",
  "description": "Delete sessions of any workspace in the DeepSeek Harness Web UI. 在 DSH Web UI 中按工作区查看并永久删除会话。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "plugin",
    "session",
    "session-manager",
    "session-cleanup",
    "workspace",
    "cordis",
    "web-ui"
  ],
  "author": {
    "name": "sdadbbb",
    "url": "https://github.com/sdadbbb"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
